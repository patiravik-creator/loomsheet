{
  "name": "loomsheet-tests",
  "private": true,
  "description": "Browser regression tests for the Loomsheet site. Serve the repo root, then `npm test`.",
  "scripts": {
    "serve": "python3 -m http.server 8899 --bind 127.0.0.1 --directory ..",
    "test": "node regression.js && node output-checks.js && node tool-pages.js",
    "build-pages": "node ../scripts/build-pages.js",
    "fixtures": "node make_fixtures.js",
    "prepare-tesseract": "node prepare-tesseract.js"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "playwright": "1.56.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1",
    "xlsx": "^0.18.5"
  }
}
